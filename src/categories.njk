---
layout: layouts/base.njk
pagination:
  data: collections.categories
  size: 1
  alias: archive
  addAllPagesToCollections: true
permalink: "{{ archive.url }}"
eleventyComputed:
  title: "{{ archive.name }} — Musings on Creativity, the Writing Journey, and Storytelling"
---
<main id="main" class="page-content archive-content">
  <h1>{{ archive.name }}</h1>
  {% include "partials/archive-links.njk" %}
  {% set archivePosts = archive.posts %}
  {% include "partials/post-list.njk" %}
</main>
