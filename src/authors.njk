---
layout: layouts/base.njk
pagination:
  data: collections.authors
  size: 1
  alias: archive
  addAllPagesToCollections: true
permalink: "{{ archive.url }}"
eleventyComputed:
  title: "{{ archive.name }} — Musings"
---
<main id="main" class="musings">
  <section class="musings-archive">
    <div class="wrap">
      <a class="back-link" href="/musings/"><span aria-hidden="true">←</span> All musings</a>
      <p class="eyebrow">Musings</p>
      <h1>Musings by {{ archive.name }}</h1>
      <p class="lede">All of Kate’s essays on creativity, the writing journey, and storytelling.</p>
      {% set archivePosts = archive.posts %}
      {% include "partials/post-list.njk" %}
      {% include "partials/archive-links.njk" %}
    </div>
  </section>
</main>
