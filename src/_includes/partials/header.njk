<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href="/">Kate Courtright</a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {% for item in navigation %}<a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif item.url != "/" and page.url.startsWith(item.url) %} aria-current="true"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Navigation" aria-controls="mobile-navigation"><span class="menu-icon" aria-hidden="true"></span></summary>
      <div id="mobile-navigation" class="mobile-menu-panel">
        <nav aria-label="Mobile navigation">
          {% for item in navigation %}<a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif item.url != "/" and page.url.startsWith(item.url) %} aria-current="true"{% endif %}><span>{{ item.label }}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg></a>
          {% endfor %}
        </nav>
        <div class="mobile-follow">
          <p class="eyebrow" id="mobile-follow-label">Follow Kate</p>
          <ul class="chips" aria-labelledby="mobile-follow-label">
            {% for social in site.social %}<li><a class="chip" href="{{ social.url }}">{{ social.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </details>
  </div>
</header>
