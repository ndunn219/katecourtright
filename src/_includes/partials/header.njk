<header class="site-header{% if hero %} site-header--hero{% endif %}">
  <a class="brand" href="/">Kate Courtright</a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {% for item in navigation %}
    <a href="{{ item.url }}"{% if item.secondary %} class="nav-secondary"{% endif %}{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {% endfor %}
  </nav>
  <details class="mobile-menu">
    <summary aria-label="Toggle navigation"><span class="menu-icon" aria-hidden="true"></span></summary>
    <nav aria-label="Mobile navigation">
      {% for item in navigation %}
      <a href="{{ item.url }}"{% if item.secondary %} class="nav-secondary"{% endif %}{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
  </details>
</header>
