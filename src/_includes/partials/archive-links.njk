<nav class="archive-links" aria-labelledby="archive-links-title">
  <p class="eyebrow" id="archive-links-title">Browse by topic</p>
  <ul class="chips">
    <li><a class="chip" href="/musings/"{% if page.url == "/musings/" %} aria-current="page"{% endif %}>All musings</a></li>
    {% for category in collections.categories %}<li><a class="chip" href="{{ category.url }}"{% if page.url == category.url %} aria-current="page"{% endif %}>{{ category.name }}</a></li>
    {% endfor %}
  </ul>
</nav>
