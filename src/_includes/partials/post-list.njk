<div class="blog-grid">
  {% for post in archivePosts %}
  <article>
    <p class="post-date"><time datetime="{{ post.data.published }}">{{ post.data.published | readableDate }}</time></p>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="post-meta"><a href="{{ post.data.authorId | authorUrl }}">{{ post.data.author }}</a></p>
    {% if post.data.categories.length %}<p class="post-categories">{% for category in post.data.categories %}<a href="{{ category | categoryUrl }}">{{ category }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
  </article>
  {% endfor %}
</div>
