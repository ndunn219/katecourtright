---
layout: layouts/base.njk
---
<main id="main" class="page-content blog-post">
  <article>
    <header>
      <p class="post-date"><time datetime="{{ published }}">{{ published | readableDate }}</time></p>
      <h1>{{ title }}</h1>
    </header>
    <div class="prose post-body">{{ content | safe }}</div>
    <p class="post-meta"><a href="{{ authorId | authorUrl }}">{{ author }}</a> · <time datetime="{{ published }}">{{ published | readableDate }}</time></p>
    {% if categories.length %}<p class="post-categories">{% for category in categories %}<a href="{{ category | categoryUrl }}">{{ category }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
  </article>
  {% set shareUrl = (canonicalPath or page.url) | canonicalUrl | encodeURIComponent %}
  <nav class="share-links" aria-label="Share this post">
    <span>Share:</span>
    <a href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl }}">Facebook</a>
    <a href="https://twitter.com/intent/tweet?url={{ shareUrl }}&amp;text={{ title | encodeURIComponent }}">Twitter</a>
    <a href="https://www.linkedin.com/shareArticle?mini=true&amp;url={{ shareUrl }}">LinkedIn</a>
    <a href="https://www.reddit.com/submit?url={{ shareUrl }}">Reddit</a>
    <a href="https://www.tumblr.com/share/link?url={{ shareUrl }}">Tumblr</a>
  </nav>
  <nav class="post-navigation" aria-label="Post navigation">
    <a href="/musings/">All musings</a>
    {% set adjacent = collections.posts | adjacentPosts(page.url) %}
    {% if adjacent.newer %}<a href="{{ adjacent.newer.url }}">Newer<br>{{ adjacent.newer.data.title }}</a>{% endif %}
    {% if adjacent.older %}<a href="{{ adjacent.older.url }}">Older<br>{{ adjacent.older.data.title }} →</a>{% endif %}
  </nav>
</main>
