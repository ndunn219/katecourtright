---
layout: layouts/base.njk
---
<main id="main">
  <div class="blog-intro">
    <h1><strong><em>{{ heading }}</em></strong></h1>
    <img src="/assets/images/musings-beach.webp" alt="A sandy path between fences leading to the sea" width="1000" height="563">
    <div class="blog-intro-copy prose">{{ content | safe }}</div>
  </div>
  <div class="page-content archive-content">
    {% include "partials/archive-links.njk" %}
    {% set archivePosts = collections.posts %}
    {% include "partials/post-list.njk" %}
  </div>
  <script src="/assets/js/author-filter.js" defer></script>
</main>
