---
layout: layouts/base.njk
---
<main id="main">
  <div id="page-content" class="page-content {{ pageClass or '' }}">
    {% if image %}<img class="page-image" src="{{ image.src }}" alt="{{ image.alt }}" width="{{ image.width }}" height="{{ image.height }}">{% endif %}
    <div class="page-copy prose">{{ content | safe }}</div>
  </div>
</main>
